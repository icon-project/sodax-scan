NEXT_PUBLIC_BASE_API_URL=http://localhost:4000/api
NEXT_PUBLIC_TESTNET_APP_URL=https://testnet.xcallscan.xyz
NEXT_PUBLIC_MAINNET_APP_URL=https://xcallscan.xyz

# --- /debugmode admin tooling (server-only, DO NOT prefix with NEXT_PUBLIC) ---
# Set the real value in .env.local (gitignored) or the host env, NEVER in .env.
# Leaving ADMIN_SECRET unset disables the /debugmode login entirely.
ADMIN_SECRET=
# Optional override; defaults to the mainnet xcall relay if unset.
RELAY_URL=